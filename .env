SITE_NAME_HEADER=Digital Garden
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=https://winstons-digitalgarden.netlify.app
SHOW_CREATED_TIMESTAMP=true
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=true
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --h1-size: 1.6em; --h2-size: 1.3em; --h3-size: 1.1em; --font-text-size: 16px; --line-height: 1.6; --max-width: 720px; --link-color: #4a9eff; --link-external-color: #6eb5ff; --tag-radius: 4px; --tag-border-width: 1px; } body.theme-dark.css-settings-manager { --text-normal: #d5d5d5; --text-muted: #888; --background-primary: #1e1e1e; --background-secondary: #161616; --code-background: #2a2a2a; --h1-color: #e0e0e0; --h2-color: #ccc; --h3-color: #bbb; }
STYLE_SETTINGS_BODY_CLASSES=theme-dark minimal-theme minimal-readable css-settings-manager callouts-default full-width-media img-default-width
USE_FULL_RESOLUTION_IMAGES=false
THEME=
BASE_THEME=dark
dgHomeLink=true
dgPassFrontmatter=false
dgShowBacklinks=true
dgShowLocalGraph=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true